# ---------------------------------------------------------------------
# ENVIRONMENT VARIABLES - copy this file to ".env" and fill in real values.
# ".env" is listed in .gitignore so your secrets never reach GitHub.
# WHY HERE AND NOT IN CODE? So the same code runs on your laptop (dev),
# a friend's laptop, and the production server - only the env file changes.
# ---------------------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Local dev (provided by this project setup):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production example (Render/Neon/Supabase - paste THEIR string instead):
# DATABASE_URL=postgresql://user:pass@db.example.com:5432/habitwealth?sslmode=require

# Secret used to SIGN login tokens (JWTs). Anyone who knows it can forge
# logins, so: long + random in production, never committed, never shared.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# NODE_ENV is set automatically by the framework ("development"/"production").
# When it is "production", session cookies become HTTPS-only automatically.
